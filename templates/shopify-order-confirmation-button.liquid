{%- assign confirm_ts = created_at | date: "%s" -%}
{%- capture confirm_payload -%}{{ id }}|{{ confirm_ts }}|{{ name }}{%- endcapture -%}
{%- assign confirm_sig = confirm_payload | hmac_sha256: "REPLACE_WITH_SHOPIFY_LINK_SECRET" -%}

<table class="row actions" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="empty-line">&nbsp;</td>
  </tr>
  <tr>
    <td class="actions__cell">
      <table class="button main-action-cell" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="button__cell" align="center" width="100%">
            <a href="https://confirm.forgedride.co/order-confirm?order_id={{ id }}&amp;order_name={{ name | url_encode }}&amp;ts={{ confirm_ts }}&amp;sig={{ confirm_sig }}"
               class="button__text" style="display:block;text-align:center;">Confirm my order</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
